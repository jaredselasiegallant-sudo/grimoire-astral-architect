<Project>
  <!-- Strip win10-* RIDs injected by WindowsAppSDK 1.5 that .NET 8 SDK doesn't recognize -->
  <Target Name="StripWin10RIDs" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <RuntimeIdentifier Remove="@(RuntimeIdentifier)" Condition="$([System.String]::new('%(RuntimeIdentifier.Identity)').Contains('win10'))" />
    </ItemGroup>
    <PropertyGroup>
      <RuntimeIdentifiers>$([System.String]::Join(';', @(RuntimeIdentifier)))</RuntimeIdentifiers>
    </PropertyGroup>
  </Target>
</Project>
