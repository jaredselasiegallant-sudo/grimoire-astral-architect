<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Grimoire.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Title="Grimoire: Astral Architect">

    <Grid Padding="0" IsTabStop="True" KeyDown="MainWindow_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="{ThemeResource PanelBackgroundBrush}"
              BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="0,0,0,1"
              Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="GRIMOIRE: ASTRAL ARCHITECT"
                       Foreground="{ThemeResource GlowCyanBrush}"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />

            <!-- Spell status -->
            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.CurrentSpellStatus, Mode=OneWay}"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />

            <!-- Cooldown indicator -->
            <TextBlock Grid.Column="3"
                       Text="{x:Bind ViewModel.CooldownDisplay, Mode=OneWay}"
                       Foreground="{ThemeResource AccentBrush}"
                       FontSize="11" VerticalAlignment="Center" Margin="12,0" />

            <!-- Mana counter -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="&#x2726;" Foreground="{ThemeResource GlowPurpleBrush}" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.ManaCrystals, Mode=OneWay}"
                           Foreground="{ThemeResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ═══ MAIN CONTENT ═════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ── Game Canvas (SkiaSharp) ─────────────────────────── -->
            <skia:SKXamlCanvas Grid.Column="0" x:Name="SKCanvasView"
                               PaintSurface="SKCanvasView_PaintSurface"
                               Background="#050510"
                               Margin="4"
                               PointerPressed="GameCanvas_PointerPressed"
                               PointerMoved="GameCanvas_PointerMoved"
                               PointerReleased="GameCanvas_PointerReleased" />

            <!-- ── Right Panel ─────────────────────────────────────── -->
            <Grid Grid.Column="1" Margin="0,4,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Inventory -->
                <Border Grid.Row="0" Background="{ThemeResource PanelBackgroundBrush}"
                        BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="INVENTORY"
                                   Foreground="{ThemeResource GlowCyanBrush}" FontSize="12" FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Inventory.Items}"
                                  Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="4" Margin="0,2" Background="#1A1A3A" CornerRadius="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{ThemeResource GlowCyanBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="Item" Foreground="{ThemeResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="x0" Foreground="{ThemeResource TextSecondaryBrush}"
                                                   FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="Transparent" />

                <!-- Cauldron -->
                <Border Grid.Row="2" Background="{ThemeResource PanelBackgroundBrush}"
                        BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ALCHEMICAL CAULDRON"
                                   Foreground="{ThemeResource GlowPurpleBrush}" FontSize="12" FontWeight="Bold"
                                   Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind ViewModel.CraftingCauldron.CraftingResult, Mode=OneWay}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Grid.Row="2" Content="&#x26A1; CRAFT" HorizontalAlignment="Stretch"
                                Background="{ThemeResource GlowPurpleBrush}" Foreground="White" FontWeight="Bold"
                                CornerRadius="6" Margin="0,4"
                                Command="{x:Bind ViewModel.CraftingCauldron.CraftCommand}"
                                IsEnabled="{x:Bind ViewModel.CraftingCauldron.CanCraft, Mode=OneWay}" />
                        <Button Grid.Row="3" Content="Clear" HorizontalAlignment="Stretch"
                                Background="Transparent" Foreground="{ThemeResource TextSecondaryBrush}"
                                BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4"
                                Command="{x:Bind ViewModel.CraftingCauldron.ClearSlotsCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="Transparent" />

                <!-- Expedition Log -->
                <Border Grid.Row="4" Background="{ThemeResource PanelBackgroundBrush}"
                        BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="12" MaxHeight="120">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="EXPEDITION LOG"
                                   Foreground="{ThemeResource GlowCyanBrush}" FontSize="12" FontWeight="Bold"
                                   Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind ViewModel.LastExpeditionLog, Mode=OneWay}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ BOTTOM BAR: FAMILIARS ════════════════════════════════ -->
        <Border Grid.Row="2" Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="FAMILIARS"
                           Foreground="{ThemeResource GlowCyanBrush}"                            FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FamiliarManagement.Familiars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="#1A1A3A" CornerRadius="8" Padding="12,8" MinWidth="120"
                                        BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Familiar" Foreground="{ThemeResource TextPrimaryBrush}"
                                                   FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Lv. 1" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="&#x1F680; Send" Background="{ThemeResource GlowCyanBrush}"
                            Foreground="#0A0A1A" FontWeight="SemiBold" CornerRadius="6" Padding="12,6"
                            Command="{x:Bind ViewModel.FamiliarManagement.SendOnExpeditionCommand}" />
                    <Button Content="&#x1F4DE; Recall" Background="Transparent"
                            Foreground="{ThemeResource AccentBrush}" BorderBrush="{ThemeResource AccentBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,6"
                            Command="{x:Bind ViewModel.FamiliarManagement.RecallFamiliarCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ NOTIFICATION TOAST OVERLAY ══════════════════════════ -->
        <StackPanel x:Name="ToastContainer" Grid.Row="0" Grid.RowSpan="3"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,56,24,0" Spacing="8" IsHitTestVisible="False" />

        <!-- ═══ NARRATIVE OVERLAY ═══════════════════════════════════ -->
        <Border x:Name="NarrativeOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="#CC0A0A1A" Visibility="Collapsed"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Padding="60">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="800">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock x:Name="NarrativeSpeaker" Text=""
                               Foreground="{ThemeResource GlowPurpleBrush}"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="NarrativeText" Text=""
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               FontSize="20" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               LineHeight="30" />
                    <Button x:Name="NarrativeDismissButton" Content="Continue"
                            HorizontalAlignment="Center" Margin="0,16,0,0"
                            Background="Transparent" Foreground="{ThemeResource TextSecondaryBrush}"
                            BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="24,8"
                            Click="NarrativeDismissButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
